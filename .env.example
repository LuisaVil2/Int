# === Traducción — DeepSeek Flash vía formato Anthropic ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash

# === STT ===
# Opcional. Si vacío, el motor en vivo usa Whisper local.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LIVE_MODEL=nova-3

# === TTS — Fish Speech (voz clonada) ===
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free

# === Terminología ===
TERMINOLOGY_DIR=data/terminology
DEFAULT_SPECIALTY=general

# Ejecutable de ffmpeg en PATH, o ruta absoluta del equipo.
FFMPEG_PATH=ffmpeg
